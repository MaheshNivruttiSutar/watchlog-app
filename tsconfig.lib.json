{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/vite-env.d.ts",
    "src/api/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/filter.ts",
    "src/utils/sort.ts",
    "src/utils/group.ts",
    "src/utils/statistics.ts"
  ],
  "exclude": ["node_modules", "dist", "lib", "src/**/__tests__/**"]
}
