{
  "name": "watchlog",
  "version": "1.0.0",
  "description": "WatchLog - Personal Movie & Book Watchlist",
  "author": "Mahesh Nivrutti Sutar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "webpack serve --config webpack/remote.config.cjs --mode development",
    "dev:host": "npm --prefix host-shell run dev",
    "build": "vite build",
    "build:remote": "webpack --config webpack/remote.config.cjs --mode production",
    "build:host": "npm --prefix host-shell run build",
    "analyze:remote": "webpack --config webpack/remote.config.cjs --mode production --env analyze",
    "analyze:host": "npm --prefix host-shell run analyze",
    "analyze:mf": "npm run analyze:remote && npm run analyze:host && node scripts/check-mf-singletons.mjs",
    "build:lib": "tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "npm run build:lib && node scripts/test-search.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "i18next": "26.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.14",
    "react-router-dom": "6.28.0",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.12.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "css-loader": "7.1.5",
    "dotenv": "16.4.5",
    "html-webpack-plugin": "5.6.8",
    "jsdom": "26.1.0",
    "postcss-loader": "8.2.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.4.5",
    "vite": "5.4.11",
    "vitest": "1.6.0",
    "webpack": "5.111.1",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  }
}
